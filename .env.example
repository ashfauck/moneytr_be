# Node Environment
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/moneytr_db?schema=public"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-characters-long-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_TEMP_TOKEN_EXPIRES_IN=5m
JWT_BIOMETRIC_CHALLENGE_EXPIRES_IN=5m

# Security
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_TIME_MS=1800000

# Session
SESSION_EXPIRES_IN=7d
DEVICE_TOKEN_EXPIRES_IN=90d

# Registration
REGISTRATION_TEMP_TOKEN_EXPIRES_IN=10m
REGISTRATION_PROFILE_SETUP_EXPIRES_IN=30m

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs
