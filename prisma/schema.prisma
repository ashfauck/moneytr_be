// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION

  @@map("account_status")
}

enum RequestType {
  LOGIN
  DOCUMENT_VERIFICATION
  PAYMENT_AUTHORIZATION

  @@map("request_type")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("request_status")
}

enum VerificationStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED

  @@map("verification_status")
}

// Models
model User {
  id                  String      @id @default(uuid())
  phoneNumber         String      @unique @map("phone_number")
  name                String?
  email               String?
  pinHash             String      @map("pin_hash")
  isVerified          Boolean     @default(false) @map("is_verified")
  biometricEnabled    Boolean     @default(false) @map("biometric_enabled")
  accountStatus       AccountStatus @default(PENDING_VERIFICATION) @map("account_status")
  loginAttempts       Int         @default(0) @map("login_attempts")
  lockUntil          DateTime?   @map("lock_until")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  lastLoginAt        DateTime?   @map("last_login_at")

  // Relations
  sessions           Session[]
  authRequests       AuthRequest[]
  deviceTokens       DeviceToken[]
  verificationRequests VerificationRequest[]
  biometricKeys      UserBiometricKey[]

  @@map("users")
  @@index([phoneNumber])
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token")
  deviceInfo   String    @map("device_info")
  ipAddress    String    @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId, isActive])
  @@index([expiresAt])
}

model DeviceToken {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  deviceId    String    @map("device_id")
  deviceToken String    @map("device_token")
  deviceInfo  String    @map("device_info")
  platform    String
  appVersion  String?   @map("app_version")
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")
  ipAddress   String    @map("ip_address")

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
  @@unique([deviceId, deviceToken])
  @@index([userId, isActive])
  @@index([deviceId])
  @@index([expiresAt])
}

model AuthRequest {
  id                    String            @id @default(uuid())
  userId               String            @map("user_id")
  requesterId          String            @map("requester_id")
  requesterName        String            @map("requester_name")
  requesterOrganization String           @map("requester_organization")
  requestType          RequestType       @map("request_type")
  status               RequestStatus     @default(PENDING)
  requestedPermissions String[]          @map("requested_permissions")
  description          String
  expiresAt           DateTime          @map("expires_at")
  respondedAt         DateTime?         @map("responded_at")
  ipAddress           String            @map("ip_address")
  userAgent           String            @map("user_agent")
  createdAt           DateTime          @default(now()) @map("created_at")

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_requests")
  @@index([userId, status])
  @@index([expiresAt])
}

model VerificationRequest {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  appName           String            @map("app_name")
  verificationNumber Int              @map("verification_number")
  status            VerificationStatus @default(PENDING)
  verifiedAt        DateTime?         @map("verified_at")
  expiresAt         DateTime          @map("expires_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_requests")
  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

model UserBiometricKey {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  publicKey     String    @map("public_key")
  biometryType  String    @map("biometry_type")
  deviceId      String?   @map("device_id")
  isActive      Boolean   @default(true) @map("is_active")
  enrolledAt    DateTime  @default(now()) @map("enrolled_at")
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_biometric_keys")
  @@index([userId])
  @@index([deviceId])
  @@index([userId, isActive])
}

model BiometricChallenge {
  id              String    @id @default(uuid())
  challengeString String    @unique @map("challenge_string")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("biometric_challenges")
  @@index([challengeString])
  @@index([expiresAt])
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklisted_tokens")
  @@index([expiresAt])
}
