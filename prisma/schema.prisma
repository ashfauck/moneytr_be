// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION

  @@map("account_status")
}

enum RequestType {
  LOGIN
  DOCUMENT_VERIFICATION
  PAYMENT_AUTHORIZATION

  @@map("request_type")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("request_status")
}

enum VerificationStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED

  @@map("verification_status")
}

// Models
model User {
  id                  String      @id @default(uuid())
  phoneNumber         String      @unique @map("phone_number")
  name                String?
  email               String?
  pinHash             String      @map("pin_hash")
  isVerified          Boolean     @default(false) @map("is_verified")
  biometricEnabled    Boolean     @default(false) @map("biometric_enabled")
  accountStatus       AccountStatus @default(PENDING_VERIFICATION) @map("account_status")
  loginAttempts       Int         @default(0) @map("login_attempts")
  lockUntil          DateTime?   @map("lock_until")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  lastLoginAt        DateTime?   @map("last_login_at")

  // Relations
  sessions           Session[]
  authRequests       AuthRequest[]
  deviceTokens       DeviceToken[]
  verificationRequests VerificationRequest[]
  biometricKeys      UserBiometricKey[]
  tradingSettings    TradingSettings?
  orders             Order[]
  positions          Position[]
  tradeLogs          TradeLog[]

  @@map("users")
  @@index([phoneNumber])
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token")
  deviceInfo   String    @map("device_info")
  ipAddress    String    @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId, isActive])
  @@index([expiresAt])
}

model DeviceToken {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  deviceId    String    @map("device_id")
  deviceToken String    @map("device_token")
  deviceInfo  String    @map("device_info")
  platform    String
  appVersion  String?   @map("app_version")
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")
  ipAddress   String    @map("ip_address")

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
  @@unique([deviceId, deviceToken])
  @@index([userId, isActive])
  @@index([deviceId])
  @@index([expiresAt])
}

model AuthRequest {
  id                    String            @id @default(uuid())
  userId               String            @map("user_id")
  requesterId          String            @map("requester_id")
  requesterName        String            @map("requester_name")
  requesterOrganization String           @map("requester_organization")
  requestType          RequestType       @map("request_type")
  status               RequestStatus     @default(PENDING)
  requestedPermissions String[]          @map("requested_permissions")
  description          String
  expiresAt           DateTime          @map("expires_at")
  respondedAt         DateTime?         @map("responded_at")
  ipAddress           String            @map("ip_address")
  userAgent           String            @map("user_agent")
  createdAt           DateTime          @default(now()) @map("created_at")

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_requests")
  @@index([userId, status])
  @@index([expiresAt])
}

model VerificationRequest {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  appName           String            @map("app_name")
  verificationNumber Int              @map("verification_number")
  status            VerificationStatus @default(PENDING)
  verifiedAt        DateTime?         @map("verified_at")
  expiresAt         DateTime          @map("expires_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_requests")
  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

model UserBiometricKey {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  publicKey     String    @map("public_key")
  biometryType  String    @map("biometry_type")
  deviceId      String?   @map("device_id")
  isActive      Boolean   @default(true) @map("is_active")
  enrolledAt    DateTime  @default(now()) @map("enrolled_at")
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_biometric_keys")
  @@index([userId])
  @@index([deviceId])
  @@index([userId, isActive])
}

model BiometricChallenge {
  id              String    @id @default(uuid())
  challengeString String    @unique @map("challenge_string")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("biometric_challenges")
  @@index([challengeString])
  @@index([expiresAt])
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklisted_tokens")
  @@index([expiresAt])
}

// Trading System Models
enum TradingMode {
  SUGGEST_ONLY
  AUTO_TRADE
  DISABLED

  @@map("trading_mode")
}

enum OrderStatus {
  PENDING
  COMPLETE
  CANCELLED
  REJECTED

  @@map("order_status")
}

enum PositionStatus {
  OPEN
  CLOSED

  @@map("position_status")
}

enum SignalType {
  BUY
  SELL
  HOLD

  @@map("signal_type")
}

model TradingSettings {
  id                String      @id @default(uuid())
  userId            String      @unique @map("user_id")
  tradingMode       TradingMode @default(SUGGEST_ONLY) @map("trading_mode")
  autoTradeEnabled  Boolean     @default(false) @map("auto_trade_enabled")
  maxDailyLoss      Float?      @map("max_daily_loss")
  maxPositionSize   Float?      @map("max_position_size")
  riskPerTrade      Float?      @map("risk_per_trade")
  stopLossPercent   Float?      @map("stop_loss_percent")
  takeProfitPercent Float?      @map("take_profit_percent")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trading_settings")
  @@index([userId])
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  kiteOrderId     String?     @unique @map("kite_order_id")
  symbol          String
  exchange        String?
  action          String      // BUY/SELL
  quantity        Int
  orderType       String      @map("order_type") // MARKET/LIMIT/SL/SL-M
  price           Float?
  triggerPrice    Float?      @map("trigger_price")
  averagePrice    Float?      @map("average_price")
  filledQuantity  Int?        @map("filled_quantity")
  status          OrderStatus @default(PENDING)
  statusMessage   String?     @map("status_message")
  pnl             Float?
  aiSignalId      String?     @map("ai_signal_id")
  source          String      @default("MANUAL") // MANUAL/AI
  createdAt       DateTime    @default(now()) @map("created_at")
  completedAt     DateTime?   @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiSignal AISignal? @relation(fields: [aiSignalId], references: [id])

  @@map("orders")
  @@index([userId, status])
  @@index([kiteOrderId])
  @@index([createdAt])
}

model Position {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  symbol        String
  exchange      String?
  quantity      Int
  averagePrice  Float          @map("average_price")
  currentPrice  Float?         @map("current_price")
  pnl           Float?
  stopLoss      Float?         @map("stop_loss")
  takeProfit    Float?         @map("take_profit")
  status        PositionStatus @default(OPEN)
  createdAt     DateTime       @default(now()) @map("created_at")
  closedAt      DateTime?      @map("closed_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("positions")
  @@index([userId, status])
  @@index([symbol])
}

model AISignal {
  id               String     @id @default(uuid())
  symbol           String
  signalType       SignalType @map("signal_type")
  confidence       Float      // 0-100
  entryPrice       Float?     @map("entry_price")
  stopLoss         Float?     @map("stop_loss")
  targetPrice      Float?     @map("target_price")
  reasoning        String?    // AI reasoning/explanation
  indicators       Json?      // Technical indicators used
  modelVersion     String?    @map("model_version")
  expiresAt        DateTime?  @map("expires_at")
  executed         Boolean    @default(false)
  executedAt       DateTime?  @map("executed_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  orders Order[]

  @@map("ai_signals")
  @@index([symbol, signalType])
  @@index([createdAt])
  @@index([executed])
}

model TradeLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  symbol      String
  action      String
  quantity    Int
  orderType   String   @map("order_type")
  price       Float?
  stopLoss    Float?   @map("stop_loss")
  takeProfit  Float?   @map("take_profit")
  aiSignalId  String?  @map("ai_signal_id")
  source      String   // MANUAL/AI
  status      String
  metadata    Json?    // Additional data
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trade_logs")
  @@index([userId])
  @@index([createdAt])
}
